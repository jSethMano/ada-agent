{
	"name": "ada-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-18",
	"observability": {
		"enabled": true,
	},
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			// The binding name drives the URL: the agents SDK routes /agents/chak/{instance} here.
			{ "name": "Chak", "class_name": "Chak" },
			{ "name": "ItAgent", "class_name": "ItAgent" },
		],
	},

	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Ada"] },
		{ "tag": "v2", "new_sqlite_classes": ["ItAgent"] },
		// Rename, not delete + create: every existing conversation stays in its Durable Object.
		{ "tag": "v3", "renamed_classes": [{ "from": "Ada", "to": "Chak" }] },
	],

	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 10, "period": 60 },
			},
		],
	},
}
