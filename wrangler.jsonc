{
	"name": "ada-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-18",
	"observability": {
		"enabled": true,
	},
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			{ "name": "Ada", "class_name": "Ada" },
			{ "name": "ItAgent", "class_name": "ItAgent" },
		],
	},

	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Ada"] },
		{ "tag": "v2", "new_sqlite_classes": ["ItAgent"] },
	],

	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 10, "period": 60 },
			},
		],
	},
}
